#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt { quick-tap-ms = <150>; };

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-on-release;
            hold-trigger-key-positions = <5 4 2 3 14 15 26 27 28 16 17 25 29 13 1 12 24 0 38 37 36>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-on-release;
            hold-trigger-key-positions = <6 18 19 7 8 20 9 21 10 11 23 22 34 35 33 32 31 30 39 40 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none  &kp SQT      &kp COMMA    &kp DOT       &kp P         &kp Y          &kp F         &kp G          &kp C        &kp R         &kp L         &none
&none  &hml LGUI A  &hml LALT O  &hml LCTRL E  &hml LSHFT U  &kp I          &kp D         &hmr RGUI H    &hmr RALT T  &hmr RCTRL N  &hmr RSHFT S  &none
&none  &kp SEMI     &kp Q        &kp J         &kp K         &kp X          &kp B         &kp M          &kp W        &kp V         &kp Z         &none
                                 &kp ESC       &kp SLASH     &lt 1 SPACE    &lt 2 RETURN  &kp BACKSPACE  &kp TAB
            >;
        };

        lower_layer {
            bindings = <
&none  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp LCTRL  &kp AMPERSAND   &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
&none  &kp F1           &kp F2       &kp F3    &kp F4      &kp F5         &kp F6     &kp UNDERSCORE  &kp PLUS      &kp LEFT_BRACE        &kp RIGHT_BRACE        &none
&none  &kp F7           &kp F8       &kp F9    &kp F10     &kp F11        &kp F12    &kp LEFT        &kp DOWN      &kp UP                &kp RIGHT              &none
                                     &trans    &trans      &trans         &trans     &trans          &trans
            >;
        };

        raise_layer {
            bindings = <
&none  &kp N1   &kp N2   &kp N3   &kp N4   &kp N5     &kp N6   &kp N7     &kp N8     &kp N9            &kp N0             &none
&none  &kp F13  &kp F14  &kp F15  &kp F16  &kp F17    &kp F18  &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
&none  &kp F19  &kp F20  &kp F21  &kp F22  &kp F23    &kp F24  &kp GRAVE  &kp TILDE  &kp BACKSLASH     &kp PIPE           &none
                         &trans   &trans   &trans     &trans   &trans     &trans
            >;
        };

        adjust_layer {
            bindings = <
&none  &bt BT_CLR    &bt BT_CLR_ALL  &bt BT_NXT    &bt BT_PRV    &trans          &trans  &trans  &trans  &trans  &trans  &none
&none  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &tog 4  &trans  &trans  &trans  &trans  &none
&none  &trans        &trans          &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &none
                                     &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };

        game_layer {
            bindings = <
&none  &kp TAB    &kp Q  &kp W      &kp E       &kp R        &kp T      &kp Y          &kp U   &kp I      &kp O    &none
&none  &kp ESC    &kp A  &kp S      &kp D       &kp F        &kp G      &kp H          &kp J   &kp K      &kp L    &none
&none  &kp LSHFT  &kp Z  &kp X      &kp C       &kp V        &kp B      &kp N          &kp M   &kp COMMA  &kp DOT  &none
                         &kp LCTRL  &lt 5 LALT  &kp SPACE    &kp ENTER  &kp BACKSPACE  &tog 4
            >;
        };

        game_extend {
            bindings = <
&none  &trans  &kp N1  &kp N2  &kp N3  &kp N4    &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &none
&none  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &none
                       &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        raise_and_lower {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
